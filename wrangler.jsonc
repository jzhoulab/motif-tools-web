{
  // Cloudflare Workers static-assets deployment for motif.zhoulab.io.
  // Assets-only (no Worker script). Deploy with:  npm run build && npm run build:site && npx wrangler deploy
  "name": "motif-tools-site",
  "compatibility_date": "2026-01-01",
  "assets": {
    "directory": "./site/dist",
    "not_found_handling": "404-page"
  },
  // Custom domain: provisions the DNS record + certificate for motif.zhoulab.io
  // (zhoulab.io must be a zone on this Cloudflare account).
  "routes": [
    { "pattern": "motif.zhoulab.io", "custom_domain": true }
  ]
}
