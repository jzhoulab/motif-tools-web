 "uncertain": [
  {
   "symbol": "TCF",
   "key": "E_PROTEIN",
   "why": "Bare Vierstra token split between AC0083:SNAI/TCF:bHLH (TCF3/4/12 E-box) and AC0308:LEF/TCF:Sox (TCF/LEF); chose the E-protein reading since TCF7L already covers TCF/LEF."
  },
  {
   "symbol": "TFAP",
   "key": "TFAP4",
   "why": "Its only archetype is AC0078:NHLH/TFAP:bHLH (bHLH class), so this token is TFAP4, not an AP-2 paralogue."
  },
  {
   "symbol": "SKOR1",
   "key": "DACH",
   "why": "SKI/SnoN-family corepressor, so it shares the DACH/SKI (Dachshund-homology, SAND-like) fold of DACH1/2; its HOCOMOCO motif nevertheless embeds with LHX3/LMX1B/ALX (TAATTA), so HD_Q50 or SAND are the alternatives."
  },
  {
   "symbol": "SKOR2",
   "key": "DACH",
   "why": "Same as SKOR1: SKI/SnoN corepressor placed with the DACH/SKI fold although its motif looks like a Q50 homeodomain site."
  },
  {
   "symbol": "TTF1",
   "key": "MYB",
   "why": "HGNC TTF1 is the Pol I transcription termination factor (Myb/SANT repeats, not NKX2-1), but its HOCOMOCO motif sits next to TWIST/NEUROD E-boxes, so the motif may not be Myb-like."
  },
  {
   "symbol": "RLF",
   "key": "ZNF_OTHER",
   "why": "C2H2 zinc-finger protein Rlf with no KRAB domain and no dedicated entry; motif embeds beside OVOL (CCGTTA)."
  },
  {
   "symbol": "SLC2A4RG",
   "key": "ZNF_OTHER",
   "why": "HDBP1/GLUT4-enhancer factor, C2H2-type ZF that works through MEF2; no dedicated entry."
  },
  {
   "symbol": "PF21A",
   "key": "CHROMATIN",
   "why": "HOCOMOCO PF21A = PHF21A/BHC80, a PHD reader in the LSD1-CoREST complex with no sequence-specific DBD (its motif is MEF2-like AT-rich)."
  },
  {
   "symbol": "POGK",
   "key": "CENPB_POGO",
   "why": "Explicitly listed in the CENPB_POGO def, though its HOCOMOCO motif embeds among K50 homeodomain (CRX/OTX/DPRX) motifs."
  },
  {
   "symbol": "TAF1",
   "key": "TBP",
   "why": "Explicit in the TBP def; note the HOCOMOCO TAF1 motif is actually YY1-like promoter sequence."
  },
  {
   "symbol": "SOHLH2",
   "key": "BHLH_OTHER",
   "why": "Germ-cell bHLH with no group of its own in the ontology."
  },
  {
   "symbol": "SIX5",
   "key": "HD_SIX",
   "why": "SIX-family homeodomain not named in the def, which lists only SIX1/2/4 and SIX3/6."
  },
  {
   "symbol": "RORG",
   "key": "ROR",
   "why": "RORG is the UniProt entry name for RORC, so it is the same factor as RORC."
  }
 ],
 "proposals": [
  {
   "key": "SKI_SNON",
   "name": "SKI / SnoN / SKOR corepressors",
   "class": "SAND (Ski homology domain)",
   "def": "Ski/SnoN-family transcriptional corepressors whose DNA contact comes from the SAND motif inside the Ski homology domain and whose motifs are typically inherited from their homeodomain/SMAD partners: SKI, SKIL, SKOR1, SKOR2.",
   "symbols": [
    "SKOR1",
    "SKOR2"
   ],
   "why": "Assigned to DACH as the nearest existing fold family, but their motifs are LHX/LBX-like rather than the forkhead-like DACH site, so either a separate SKI/SnoN entry or an explicit widening of the DACH def is needed."
  }
 ]
}